{
  "name": "copy-with-context",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.0.0",
  "publisher": "your-name",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "copy",
    "context",
    "ai",
    "clipboard",
    "development",
    "productivity"
  ],
  "activationEvents": [
    "onCommand:copy-with-context.copyWithContext"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copy-with-context.copyWithContext",
        "title": "%command.copyWithContext.title%",
        "category": "%command.copyWithContext.category%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "copy-with-context.copyWithContext",
          "when": "editorTextFocus && editorHasSelection",
          "group": "modification@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "copy-with-context.copyWithContext",
          "when": "editorTextFocus && editorHasSelection",
          "group": "modification@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "copy-with-context.copyWithContext",
        "key": "%keybindings.copyWithContext.key%",
        "mac": "%keybindings.copyWithContext.mac%",
        "when": "%keybindings.copyWithContext.when%"
      }
    ],
    "configuration": {
      "title": "%config.copyWithContext.title%",
      "properties": {
        "copyWithContext.format": {
          "type": "string",
          "default": "",
          "title": "%config.copyWithContext.format.title%",
          "description": "%config.copyWithContext.format.description%"
        },
        "copyWithContext.includeWorkspace": {
          "type": "boolean",
          "default": true,
          "title": "%config.copyWithContext.includeWorkspace.title%",
          "description": "%config.copyWithContext.includeWorkspace.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package",
    "build": "npm run compile && npm run package",
    "publish": "vsce publish",
    "update-l10n": "node ./scripts/update-l10n.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^18.19.0",
    "@types/mocha": "^10.0.6",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "typescript": "^5.3.3",
    "@vscode/vsce": "^2.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/copy-with-context.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/copy-with-context/issues"
  },
  "homepage": "https://github.com/your-username/copy-with-context#readme",
  "license": "MIT"
}
